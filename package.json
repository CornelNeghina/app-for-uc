{
    "name": "task-api",
    "version": "1.0.0",
    "description": "Simple REST API for managing tasks - perfect for integration testing",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest --coverage",
        "test:integration": "jest --testPathPattern=tests/integration"
    },
    "keywords": [
        "api",
        "rest",
        "tasks",
        "integration-tests"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "express": "^4.18.2",
        "body-parser": "^1.20.2",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "jest": "^29.5.0",
        "supertest": "^6.3.3",
        "nodemon": "^2.0.22"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    }
}